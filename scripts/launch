#!/bin/bash

# DWL startup script

wlr-randr --output DP-1 --left-of eDP-1
dbus-daemon --session &
eval $(dbus-launch &) && export DBUS_SESSION_BUS_ADDRESS &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
dunst &
~/.go/bin/clipse -listen
awww-daemon &
emacs --daemon
otd-daemon &
exec ~/.config/dwl/scripts/screenshare-fix.sh &
